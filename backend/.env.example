PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vr4web
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ADMIN_INITIAL_EMAIL=sanjay@niftysoft.in
ADMIN_INITIAL_PASSWORD=admin@123
ADMIN_NOTIFICATION_EMAIL=sanjay@niftysoft.in

# Mail Server Configuration (Amazon SES / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@yourdomain.com
MAIL_FROM_NAME="VR4Web Team"
